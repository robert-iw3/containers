# Copy to .env and fill in — or let scripts/render.sh generate it (secrets are
# auto-generated on first run and reused thereafter). .env is gitignored.
#
# Issuer host consistency: TLS_PORT MUST equal traefik's internal entrypoint
# (8443), so the Keycloak issuer URL is identical for the browser and for
# OpenWebUI's back-channel token exchange.

# --- Network / proxy -----------------------------------------------------
COMPOSE_NET_NAME=neo4j-stack
NET_SUBNET=172.31.30.0/24          # keep in sync with postgres/pg_hba.conf
TRAEFIK_IP=172.31.30.10
BIND_ADDR=127.0.0.1                # 0.0.0.0 to expose beyond the host
TLS_PORT=8443
TLS_DIR=/etc/ssl/neo4j-stack       # holds tls.crt, tls.key, ca.crt
DOCKER_SOCKET=/var/run/docker.sock

# --- Public hostnames (terminated by traefik) ---------------------------
APP_HOST=chat.neo4j.example.com
KEYCLOAK_HOST=keycloak.neo4j.example.com
KEYCLOAK_REALM=neo4j

# --- Keycloak ------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
KEYCLOAK_DB_PASSWORD=change-me-kcdb

# --- OpenWebUI -----------------------------------------------------------
OPENWEBUI_DB_PASSWORD=change-me-owdb
WEBUI_SECRET_KEY=change-me-generate-32-bytes-hex
# OIDC client credentials — must match the imported Keycloak realm.
OAUTH_CLIENT_ID=openwebui
OAUTH_CLIENT_SECRET=change-me-oidc-secret

# --- Neo4j ---------------------------------------------------------------
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j

# --- GraphRAG / models ---------------------------------------------------
# Bearer token OpenWebUI uses to call the GraphRAG OpenAI-compatible API.
GRAPHRAG_API_KEY=change-me-graphrag-key
# Ollama chat model (pulled automatically). Or set an OpenAI/Bedrock id.
LLM=llama3.2:3b
# sentence_transformer runs in-process (no API key); or: ollama, openai, aws.
EMBEDDING_MODEL=sentence_transformer
RAG_SEARCH_TYPE=vector             # or 'hybrid' (also uses the fulltext index)
RAG_USE_COMPRESSION=false

# --- Optional provider keys (only if using hosted models/embeddings) -----
#OPENAI_API_KEY=
#GOOGLE_API_KEY=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=us-east-1
