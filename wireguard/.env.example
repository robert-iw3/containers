# Copy to .env and adjust. The UAT generates its own uat/.env and peer configs.
WG_IMAGE=docker.io/library/alpine:3.24
TRANSIT_SUBNET=172.31.30.0/24
SITE_A_ADDR=10.9.0.1/24
SITE_B_ADDR=10.9.0.2/24
SITE_B_NETWORKS=10.55.0.0/24
COMPOSE_NET_NAME=wireguard-transit
# Directory holding generated peer configs wg-a.conf / wg-b.conf.
WG_DIR=./uat/wg
