# Workstation — copy to .env and fill in (values from the bastion admin).
# The bastion's public control-plane URL.
HEADSCALE_URL=http://bastion.example.com:8080
# Your personal pre-auth key (headscale user 2 "endpoint").
ENDPOINT_AUTHKEY=
# The bastion's tailnet IP (ask the admin; typically 100.64.0.1).
BASTION_HOST=100.64.0.1
# A name for this workstation in the tailnet.
WORKSTATION_NAME=dev-workstation
# Brokered ports to expose on your localhost (must match the bastion allow-list).
FORWARD_PORTS=9200 9202
BOUNDARY_API_PORT=9200
BOUNDARY_PROXY_PORT=9202
