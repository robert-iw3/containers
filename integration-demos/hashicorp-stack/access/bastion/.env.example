# Bastion (jump host) — copy to .env and fill in.
# Public IP/interface the control plane + DERP bind to (workstations reach this).
BASTION_PUBLIC_IP=0.0.0.0
# Pre-auth key for the bastion's own tailnet node (headscale user 1 "bastion").
BASTION_AUTHKEY=
# Ports the broker forwards to internal targets — the allow-list. Must match the
# hosts in ../config/policy.hujson. Default: Boundary API + worker proxy.
BROKER_TARGETS=9200=boundary:9200,9202=boundary:9202
