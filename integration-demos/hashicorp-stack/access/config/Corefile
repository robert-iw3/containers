# CoreDNS on the bastion: secure DNS (DoT upstream) plus the internal names the
# broker resolves its targets by. Only the bastion queries it; internal hosts
# are never exposed to workstations.
(resolver) {
    errors
    log
    hosts {
        172.30.77.10 boundary.hashi.internal
        fallthrough
    }
    cache 30
    forward . tls://9.9.9.9 tls://149.112.112.112 {
        tls_servername dns.quad9.net
        health_check 5s
    }
}

.:53 {
    import resolver
    ready
    health :8080
}
