# Copy to .env (or let run_demo.sh generate it with random values).

APP_DB_PASSWORD=change-me
BOUNDARY_DB_PASSWORD=change-me

# base64-encoded 256-bit AEAD keys: openssl rand -base64 32
BOUNDARY_ROOT_KEY=change-me
BOUNDARY_WORKER_AUTH_KEY=change-me
BOUNDARY_RECOVERY_KEY=change-me

# address boundary clients use to reach the worker proxy (published as 19202)
BOUNDARY_PUBLIC_ADDR=127.0.0.1:19202
