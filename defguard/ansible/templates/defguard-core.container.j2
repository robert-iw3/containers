# {{ ansible_managed }}
# Defguard core: web UI/REST on 8000, gateway-facing gRPC on 50055. Restart is
# throttled (RestartSec + StartLimitBurst) so a config error can never become an
# unbounded crash loop.
[Unit]
Description=Defguard core (control plane)
After=defguard-db.service
Requires=defguard-db.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Container]
Image={{ core_image }}
ContainerName=defguard-core
Network=defguard.network
EnvironmentFile={{ conf_dir }}/core.env
PublishPort={{ bind_addr }}:{{ core_http_port }}:8000
PodmanArgs=--memory=1g
NoNewPrivileges=true
# The image ships no curl/wget; bash's /dev/tcp probes the health endpoint
# (nested bash -c because the health test runs under /bin/sh).
HealthCmd=bash -c 'exec 3<>/dev/tcp/127.0.0.1/8000 && printf "GET /api/v1/health HTTP/1.0\r\n\r\n" >&3 && head -1 <&3 | grep -q 200'
HealthInterval=10s
HealthRetries=12
HealthStartPeriod=25s
Notify=healthy

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target default.target
