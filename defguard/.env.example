# Copy to .env and replace every CHANGE_ME. The UAT generates its own uat/.env.
CORE_IMAGE=ghcr.io/defguard/defguard:1.4.0
GATEWAY_IMAGE=ghcr.io/defguard/gateway:1.4.0
POSTGRES_IMAGE=docker.io/library/postgres:18-alpine
POSTGRES_DB=defguard
POSTGRES_USER=defguard
POSTGRES_PASSWORD=CHANGE_ME_db_password
# Core secrets. DEFGUARD_SECRET_KEY must be at least 64 characters.
DEFGUARD_AUTH_SECRET=CHANGE_ME_auth_secret
DEFGUARD_GATEWAY_SECRET=CHANGE_ME_gateway_secret
DEFGUARD_YUBIBRIDGE_SECRET=CHANGE_ME_yubi_secret
DEFGUARD_SECRET_KEY=CHANGE_ME_secret_key_at_least_64_characters_long_xxxxxxxxxxxxxxxxxx
DEFGUARD_DEFAULT_ADMIN_PASSWORD=CHANGE_ME_admin_password
DEFGUARD_URL=http://localhost:8000
DEFGUARD_COOKIE_DOMAIN=localhost
DEFGUARD_COOKIE_INSECURE=true
BIND_ADDR=127.0.0.1
CORE_HTTP_PORT=8000
WG_PORT=51820
NET_SUBNET=172.32.10.0/24
COMPOSE_NET_NAME=defguard
# Gateway token from core (created after a VPN network exists — see docker-compose.yml).
DEFGUARD_TOKEN=
