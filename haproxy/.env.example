# Copy to .env and adjust. The UAT generates its own uat/.env; these values are
# for running the compose stack directly.
PROXY_IMAGE=docker.io/library/haproxy:3.2
BIND_ADDR=127.0.0.1
TLS_PORT=8443
HTTP_PORT=8080
# Directory holding haproxy.pem (cert+key concatenated). Run uat/run-uat.sh once
# to generate one into uat/tls, or point this at your own PEM directory.
TLS_DIR=./uat/tls
COMPOSE_NET_NAME=haproxy-proxy-net
