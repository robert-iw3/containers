# Copy to .env (or run ./scripts/bootstrap-env.sh to generate random values).
# Consumed at first container start; nothing is baked into the image.

POSTGRES_USER=vectoradmin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vectors

# Least-privilege application roles created by init/01-init.sh.
APP_RW_PASSWORD=change-me
APP_RO_PASSWORD=change-me
