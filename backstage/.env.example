# Copy to .env (or let run_portal.sh generate it with random values).

# Postgres superuser (used by Vault to manage/rotate portal + DBA creds)
PG_SUPER_PASSWORD=change-me
# Throwaway: replaced by Vault the moment the static role is registered
BOOTSTRAP_DB_PASSWORD=change-me

# Boundary's own database
BOUNDARY_PG_PASSWORD=change-me

# base64-encoded 256-bit AEAD keys: openssl rand -base64 32
PORTAL_KMS_ROOT_KEY=change-me
PORTAL_KMS_WORKER_KEY=change-me
PORTAL_KMS_RECOVERY_KEY=change-me

# worker address advertised to boundary clients; sessions are opened from
# inside the stack network (portal-session.sh), so use the in-network name
PORTAL_PUBLIC_ADDR=boundary:9202

# static service-to-service token for the portal API (UAT battery)
UAT_STATIC_TOKEN=change-me

# express session secret for the OIDC handshake
PORTAL_SESSION_SECRET=change-me

# Gitea admin (provisioned by scripts/gitea-setup.sh, stored in Vault kv)
GITEA_ADMIN_USER=portal-admin
GITEA_ADMIN_PASSWORD=change-me

# Keycloak (identity provider)
KC_ADMIN_PASSWORD=change-me
KC_DB_PASSWORD=change-me
# demo end user provisioned in the portal realm
PORTAL_DEV_PASSWORD=change-me
