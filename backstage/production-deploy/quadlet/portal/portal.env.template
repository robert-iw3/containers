# bridged container via podman's gateway alias
POSTGRES_HOST=host.containers.internal
POSTGRES_PORT=20001
BACKSTAGE_API_TOKEN=${BACKSTAGE_API_TOKEN}
AUTH_SESSION_SECRET=${AUTH_SESSION_SECRET}
NODE_EXTRA_CA_CERTS=/tls/ca.crt
