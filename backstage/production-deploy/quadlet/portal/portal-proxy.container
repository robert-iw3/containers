# nginx TLS + path routing to the split deployments. The Boundary dev-portal
# target points at this host:8443; restrict the firewall so ONLY the access
# host can reach it.
[Unit]
Description=Portal routing proxy (nginx)
After=backstage-a.service
Wants=backstage-b.service

[Container]
Image=docker.io/library/nginx:1.30-alpine
ContainerName=portal-proxy
Network=portal.network
Volume=/etc/backstage-portal/proxy/nginx.conf:/etc/nginx/nginx.conf:ro,Z
Volume=/etc/backstage-portal/tls:/portal-certs:ro,Z
PublishPort=8443:8443
NoNewPrivileges=true
HealthCmd=wget -q -O- --no-check-certificate https://127.0.0.1:8443/healthz
HealthInterval=10s
HealthRetries=5
HealthStartPeriod=15s
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
