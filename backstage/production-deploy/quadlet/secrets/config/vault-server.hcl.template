# Production Vault: raft, TLS from the host PKI dir, Consul registration.
# mlock stays ON (the unit grants IPC_LOCK; host swap must be off).

ui            = true
cluster_name  = "backstage-portal"

api_addr     = "https://${SECRETS_HOST}:8200"
cluster_addr = "https://${SECRETS_HOST}:8201"

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_cert_file   = "/tls/vault.crt"
  tls_key_file    = "/tls/vault.key"
  tls_min_version = "tls12"
}

storage "raft" {
  path    = "/vault/data"
  node_id = "vault-0"
}

service_registration "consul" {
  address     = "${MESH_HOST}:8501"
  scheme      = "https"
  tls_ca_file = "/tls/ca.crt"
  service     = "vault"
}

log_level  = "info"
log_format = "json"
