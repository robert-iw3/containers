# Vault: raft storage, TLS, registers in the Consul catalog. mlock enabled
# (see host-prep secrets role: swap off, no core dumps).
# Config: /etc/backstage-portal/vault/vault-server.hcl (rendered)
[Unit]
Description=Portal Vault (secrets)
After=network-online.target
Wants=network-online.target

[Container]
Image=__REGISTRY__/vault:2.0.3
ContainerName=portal-vault
Network=portal.network
Environment=VAULT_ADDR=https://127.0.0.1:8200
Environment=VAULT_CACERT=/tls/ca.crt
Environment=SKIP_CHOWN=true
Environment=SKIP_SETCAP=true
Exec=vault server -config=/vault/config/vault-server.hcl
AddCapability=IPC_LOCK
Volume=vault-data.volume:/vault/data
Volume=/etc/backstage-portal/vault:/vault/config:ro,Z
Volume=/etc/backstage-portal/tls:/tls:ro,Z
PublishPort=8200:8200
PublishPort=8201:8201
NoNewPrivileges=true
HealthCmd=curl -sf --cacert /tls/ca.crt "https://127.0.0.1:8200/v1/sys/health?uninitcode=200&sealedcode=200&standbyok=true"
HealthInterval=10s
HealthRetries=5
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
LimitNOFILE=262144
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
