# Consul agent for the data host: joins the mesh server, registers the
# postgres service + its Connect sidecar. Host networking so gossip and the
# sidecar's public listener are reachable from other VMs.
[Unit]
Description=Consul agent (data host)
After=network-online.target postgres.service
Wants=network-online.target

[Container]
Image=__REGISTRY__/consul:2.0.2
ContainerName=portal-consul-agent
Network=host
Exec=agent
Environment=CONSUL_DISABLE_PERM_MGMT=true
Volume=consul-agent-data.volume:/consul/data
Volume=/etc/backstage-portal/consul-agent:/consul/config:ro,Z
Volume=/etc/backstage-portal/tls:/tls:ro,Z
NoNewPrivileges=true
HealthCmd=curl -sf --cacert /tls/ca.crt https://127.0.0.1:8501/v1/agent/self
HealthInterval=10s
HealthRetries=5
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
LimitNOFILE=262144

[Install]
WantedBy=multi-user.target
