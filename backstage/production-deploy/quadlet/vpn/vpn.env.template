# Rendered by deploy.sh from hosts.env -> /etc/backstage-portal/vpn.env
# The bastion node's own tailnet key (headscale user "bastion").
TS_AUTHKEY=${VPN_BASTION_AUTHKEY}
# Allow-list: <listen_port>=<internal_host:port>, comma-separated. Must match
# quadlet/vpn/config/policy.hujson. Default: Backstage portal + Boundary proxy.
BROKER_TARGETS=27007=${PORTAL_HOST}:27007,9202=${ACCESS_HOST}:9202
