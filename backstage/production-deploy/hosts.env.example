# Copy to hosts.env. One VM per role; FQDNs must resolve between hosts.
# deploy.sh renders each role's env template against these values.

# registry holding the four locally built images (backstage-portal, consul,
# vault, boundary) and, ideally, mirrors of the pinned upstream images
REGISTRY=registry.example.internal/portal

MESH_HOST=consul.portal.internal        # Consul server (Connect CA, catalog, intentions)
MESH_ADVERTISE_IP=10.0.0.10             # Consul server VM IP (gossip advertise)
DATA_ADVERTISE_IP=10.0.0.11             # data host VM IP (consul agent advertise)
SCM_ADVERTISE_IP=10.0.0.12              # scm host VM IP
PORTAL_ADVERTISE_IP=10.0.0.13           # portal host VM IP
DATA_HOST=db.portal.internal            # Postgres 18 (catalog + keycloak + boundary DBs) + backups
SCM_HOST=git.portal.internal            # Gitea (dev project storage)
SECRETS_HOST=vault.portal.internal      # Vault (raft, TLS)
IDENTITY_HOST=sso.portal.internal       # Keycloak (OIDC)
ACCESS_HOST=boundary.portal.internal    # Boundary controller+worker (brokered resource access)
PORTAL_HOST=portal.portal.internal      # backstage-a/b + nginx path router + egress sidecar
VPN_HOST=vpn.portal.internal            # VPN bastion: the ONLY door remote devs enter through

# public names end users see (Boundary worker + Keycloak browser URLs)
BOUNDARY_PUBLIC_ADDR=boundary.example.com:9202
KEYCLOAK_PUBLIC_URL=https://sso.example.com:8443
PORTAL_PUBLIC_URL=https://portal.example.com:27007
# VPN control-plane URL remote workstations reach (front with TLS in production)
VPN_PUBLIC_URL=http://vpn.example.com:8080

# secrets — replace all of these (openssl rand -hex 24 / -base64 32)
PG_SUPER_PASSWORD=change-me
BOOTSTRAP_DB_PASSWORD=change-me
BOUNDARY_PG_PASSWORD=change-me
KC_DB_PASSWORD=change-me
KC_ADMIN_PASSWORD=change-me
PORTAL_KMS_ROOT_KEY=change-me
PORTAL_KMS_WORKER_KEY=change-me
PORTAL_KMS_RECOVERY_KEY=change-me
BACKSTAGE_API_TOKEN=change-me
AUTH_SESSION_SECRET=change-me
# VPN bastion's own tailnet node key (mint after headscale is up:
#   podman exec portal-headscale headscale users create bastion
#   podman exec portal-headscale headscale preauthkeys create --user 1 --reusable --expiration 720h)
VPN_BASTION_AUTHKEY=change-me
