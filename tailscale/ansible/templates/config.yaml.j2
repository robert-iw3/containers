# {{ ansible_managed }}
# Rendered from stack.yaml. Mirrors config/config.yaml (the demo the UAT drives).
# server_url must be reachable by every tailnet member; the co-located router
# reaches it at the static hs_ip. For members on other hosts, front headscale
# with TLS + a domain and set server_url accordingly.
server_url: http://{{ hs_ip }}:{{ hs_port }}
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090
grpc_listen_addr: 0.0.0.0:50443
grpc_allow_insecure: false

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: true
    region_id: 999
    region_code: headscale
    region_name: Headscale Embedded DERP
    stun_listen_addr: 0.0.0.0:3478
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
  urls: []
  paths: []
  auto_update_enabled: false

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite

dns:
  magic_dns: false
  override_local_dns: false
  base_domain: tailnet.local
  nameservers:
    global: []

log:
  level: warn
