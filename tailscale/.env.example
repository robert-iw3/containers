# Copy to .env and adjust. The UAT generates its own uat/.env (including a fresh
# TS_AUTHKEY); these values are for running the compose stack directly.
HEADSCALE_IMAGE=docker.io/headscale/headscale:v0.29.2
TAILSCALE_IMAGE=docker.io/tailscale/tailscale:v1.98.9
BIND_ADDR=127.0.0.1
HS_PORT=8080
HS_IP=172.30.9.2
NET_SUBNET=172.30.9.0/24
ADVERTISE_ROUTES=10.55.0.0/24
COMPOSE_NET_NAME=tailscale-tailnet
# Pre-auth key from headscale (create after headscale is up — see docker-compose.yml).
TS_AUTHKEY=
