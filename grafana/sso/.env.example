# Copy to .env and replace every placeholder before deploying.
#   cp .env.example .env && chmod 600 .env

# --- Network -------------------------------------------------------------
COMPOSE_NET_NAME=grafana-sso
NET_SUBNET=172.31.10.0/24
# Address Grafana trusts to present the authenticated identity. It must be
# traefik's address on the network above and nothing else.
TRAEFIK_IP=172.31.10.10

# --- Published endpoint --------------------------------------------------
BIND_ADDR=0.0.0.0
TLS_PORT=443
APP_HOST=grafana.example.com
AUTH_HOST=sso.grafana.example.com
# Directory holding tls.crt and tls.key for the two hostnames above.
TLS_DIR=/etc/ssl/grafana-sso
# Rootless podman: /run/user/$(id -u)/podman/podman.sock
DOCKER_SOCKET=/var/run/docker.sock

# --- tinyauth ------------------------------------------------------------
# Session signing secret, exactly 32 characters:
#   openssl rand -hex 16
TINYAUTH_SECRET=CHANGE_ME_32_CHARACTER_SECRET___
TINYAUTH_APP_URL=https://sso.grafana.example.com
# Local users as user:bcrypt-hash pairs, comma separated:
#   htpasswd -nbB alice 'password'
# To authenticate against an OIDC provider instead, put the GENERIC_*
# settings from ci/sso/tinyauth-oidc.env.example into sso/tinyauth.env.
TINYAUTH_USERS=CHANGE_ME

# --- Grafana -------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
# Break-glass local admin, used when the gateway is unavailable.
ADMIN_PASSWORD=CHANGE_ME
# Role granted to a user signing in through SSO for the first time:
# Viewer, Editor or Admin.
GRAFANA_DEFAULT_ROLE=Editor
