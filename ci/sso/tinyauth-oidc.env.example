# Identity provider settings for the devops stacks' tinyauth gateway.
#
# Copy the block you need into a stack's sso/.env. tinyauth is the policy
# enforcement point in every case; what changes is where it verifies
# credentials. Local users are the default so a stack stands up on its own;
# the GENERIC_* block turns tinyauth into an OIDC relying party for any
# compliant provider.

# --- Option 1: local users (default, self-contained) ----------------------
# user:bcrypt-hash pairs, comma separated:
#   htpasswd -nbB alice 'password'
TINYAUTH_USERS=CHANGE_ME

# --- Option 2: any OIDC provider ------------------------------------------
# Register a confidential client with the provider first. Its redirect URI
# is https://<AUTH_HOST>/api/oauth/callback/generic — the tinyauth login
# hostname for the stack, not the application hostname.
#
# Leave TINYAUTH_USERS unset when running OIDC-only, or keep it for a local
# break-glass account that works when the provider is unreachable.
#
#GENERIC_NAME=Corporate SSO
#GENERIC_CLIENT_ID=
#GENERIC_CLIENT_SECRET=
#GENERIC_SCOPES=openid email profile
#GENERIC_AUTH_URL=
#GENERIC_TOKEN_URL=
#GENERIC_USER_URL=
# Restrict who may sign in (comma separated emails, or a regex):
#OAUTH_WHITELIST=
# Send users straight to the provider instead of showing a chooser:
#OAUTH_AUTO_REDIRECT=generic
# Only for a provider using a private CA that tinyauth does not trust.
# Prefer mounting the CA into the container over disabling verification.
#GENERIC_SKIP_SSL=false

# Endpoint values for the identity stacks in this repository. Substitute the
# issuer host you deployed; each is the provider's published discovery data
# (GET https://<issuer>/.well-known/openid-configuration).
#
# zitadel     AUTH  https://<issuer>/oauth/v2/authorize
#             TOKEN https://<issuer>/oauth/v2/token
#             USER  https://<issuer>/oidc/v1/userinfo
#
# authentik   AUTH  https://<issuer>/application/o/authorize/
#             TOKEN https://<issuer>/application/o/token/
#             USER  https://<issuer>/application/o/userinfo/
#
# keycloak    AUTH  https://<issuer>/realms/<realm>/protocol/openid-connect/auth
#             TOKEN https://<issuer>/realms/<realm>/protocol/openid-connect/token
#             USER  https://<issuer>/realms/<realm>/protocol/openid-connect/userinfo

# --- Option 3: hosted providers -------------------------------------------
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
