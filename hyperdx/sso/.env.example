# Copy to .env and replace every placeholder before deploying.
#   cp .env.example .env && chmod 600 .env

# --- Network -------------------------------------------------------------
COMPOSE_NET_NAME=hyperdx-sso
NET_SUBNET=172.31.13.0/24
TRAEFIK_IP=172.31.13.10

# --- Published endpoint --------------------------------------------------
BIND_ADDR=0.0.0.0
TLS_PORT=443
APP_HOST=hyperdx.example.com
AUTH_HOST=sso.hyperdx.example.com
TLS_DIR=/etc/ssl/hyperdx-sso
DOCKER_SOCKET=/var/run/docker.sock

# --- tinyauth ------------------------------------------------------------
# 32 characters: openssl rand -hex 16
TINYAUTH_SECRET=CHANGE_ME_32_CHARACTER_SECRET___
TINYAUTH_APP_URL=https://sso.hyperdx.example.com
# Local users (htpasswd -nbB alice 'password'), or use OIDC via
# sso/tinyauth.env — see ci/sso/tinyauth-oidc.env.example.
TINYAUTH_USERS=CHANGE_ME
