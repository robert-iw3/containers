# Copy to .env and replace every placeholder before deploying.
# Generate strong secrets, e.g.: openssl rand -base64 30

# PostgreSQL credentials
POSTGRESQL_USERNAME=keycloak
POSTGRESQL_PASSWORD=CHANGE_ME
POSTGRESQL_DATABASE=keycloak

# Keycloak bootstrap admin (used once on first start; rotate afterwards
# via the admin console, then remove from this file)
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=CHANGE_ME

# Public URLs (traefik terminates TLS)
KEYCLOAK_DOMAIN=keycloak.example.com
KEYCLOAK_HOSTNAME=https://keycloak.example.com
TRAEFIK_DOMAIN=traefik.example.com

# Traefik dashboard basic auth: openssl passwd -6 '<password>'
TRAEFIK_AUTH_HASHED_PASSWORD=CHANGE_ME
LETSENCRYPT_EMAIL=your.email@example.com

KEYCLOAK_LOGLEVEL=info

# Container runtime socket for the traefik docker provider
SOCKET_PATH=/var/run/docker.sock
#SOCKET_PATH=/run/podman/podman.sock

# --- Kubernetes manifest flow only (deploy.yaml via deploy_keycloak.py) ---
POSTGRESQL_REPLICATION_USER=repl_user
POSTGRESQL_REPLICATION_PASSWORD=CHANGE_ME
DB_VENDOR=postgres
DB_ADDR=postgres
JGROUPS_DISCOVERY_PROTOCOL=dns.DNS_PING
JGROUPS_DISCOVERY_PROPERTIES=dns_query=keycloak.keycloak.svc.cluster.local
PROXY_ADDRESS_FORWARDING=true
