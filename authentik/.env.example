# Authentik deployment environment variables.
# Copy to .env and fill in secrets, or run: python3 deploy.py --generate-env

# PostgreSQL (official postgres image variable names)
POSTGRES_USER=authentik
# Generate with: python3 deploy.py --generate-env
POSTGRES_PASSWORD=
POSTGRES_DB=authentik

# Authentik
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.5.5
# Generate with: python3 deploy.py --generate-env
AUTHENTIK_SECRET_KEY=
# Initial akadmin password/token set on first start (bootstrap only)
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@example.com
AUTHENTIK_EMAIL__HOST=smtp.example.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__FROM=authentik@example.com
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10

# Published ports (server only; postgres/redis stay on the internal network)
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# Container runtime socket mounted (read-only) into the socket proxy
SOCKET_PATH=/var/run/docker.sock
#SOCKET_PATH=/run/podman/podman.sock
