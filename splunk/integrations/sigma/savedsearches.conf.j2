{# Emits one savedsearches.conf stanza per converted Sigma rule.

   Each rule writes a correlated detection event into its own index rather
   than only raising an alert action. The written event carries the rule's
   identity and severity next to the fields of the log that matched, which
   makes the detection result searchable on its own: retention can differ
   from the raw data, a dashboard reads a small index instead of scanning
   everything, and the rule's metadata travels with the evidence rather
   than living only in the rule file.

   savedsearches.conf takes conf keys, not REST API names: counttype,
   relation and quantity. alert_type / alert_comparator / alert_threshold
   are rejected, and because the default is "counttype = always" a wrong
   key makes every alert fire on every run instead of failing loudly.

   Every emitted line must be "key = value". Continuation lines end with a
   backslash and must not be followed by a blank line, or the value ends
   early and the remainder is parsed as its own malformed line. #}
{% for rule in detection_rules %}
# Generated with Sigma2SplunkAlert
{% if rule.rule_id %}
# Sigma rule id: {{ rule.rule_id }}
{% endif %}
{% if rule.datamodel %}
# Candidate CIM data model: {{ rule.datamodel }} (annotation only; use --pipeline cim for data model queries)
{% endif %}
{{ rule.confidence_comment }}
[{{ rule.stanza }}]
{% if rule.description %}
description = {{ rule.description }}{% if rule.tags %} | tags: {{ rule.tags | join(', ') }}{% endif %} | level: {{ rule.level }}
{% endif %}
{#- The detection, then enrichment naming which rule fired, then a write
    into the detection index. The eval fields are what make the written
    event useful without the rule file beside it, and collect sets its own
    source type so detection results stay separable from raw data.

    Built with set rather than an inline if: this environment has
    trim_blocks on, so a block tag at the end of the search line eats the
    newline after it and the next key runs into the value. -#}
{% set ai = config.alert_index %}
{% set al = config.alerting | default({}) %}
{% if rule.disposition == 'immediate' %}
{% set min_matches = 1 %}
{% else %}
{% set min_matches = al.trend_min_matches | default(2) %}
{% endif %}
{% set keys = al.correlation_fields | default('host') %}
{# One detection per group, not per matching event. Without the stats a rule
   matching eighty failed logons writes eighty detection events, which is
   eighty repetitions of one fact.

   The origin fields are captured here because summary indexing rewrites
   index and sourcetype on the way out; captured afterwards, the trail back
   to the log that matched would be gone.

   _time is set to first seen so the detection lands when the activity
   started rather than when the search noticed it. #}
{% set agg = ' | stats count as sigma_match_count, min(_time) as sigma_first_seen,'
     ~ ' max(_time) as sigma_last_seen, earliest(_raw) as sigma_sample,'
     ~ ' values(index) as sigma_src_index, values(sourcetype) as sigma_src_sourcetype,'
     ~ ' dc(host) as sigma_host_count by ' ~ keys
     ~ ' | where sigma_match_count >= ' ~ min_matches
     ~ ' | eval _time=sigma_first_seen, sigma_src_host=host,'
     ~ ' sigma_span_seconds=sigma_last_seen-sigma_first_seen' %}
{# The search must say which indexes to look in. A saved search with no
   index scope searches only the role's default indexes, which is how 558
   correctly scheduled rules found nothing at all. The macro lets an
   operator point every rule at their data in one place. #}
search = {{ config.index_scope | default('`sigma_lab_index`') }} {{ rule.splunk_search }}{% if ai and ai.enabled %}{{ agg }}{% endif %}
counttype = number of events
relation = greater than
quantity = 0
enableSched = 1
{# Continuous scheduling. The default, realtime_schedule = true, lets the
   scheduler skip execution periods under load, and the spec is explicit
   that continuous scheduling is required whenever a search writes to a
   summary index -- which every one of these does, via collect. A skipped
   period loses the detection silently and leaves a hole in the index. #}
realtime_schedule = 0
{# Let the scheduler distribute start times rather than every rule asking
   for the same minute. allow_skew only applies to */M crons, which is why
   the cron is left in that form. #}
allow_skew = {{ config.allow_skew | default('100%') }}
{% if rule.disposition == 'immediate' %}
{# A severe, specific detection should not queue behind the trend rules. #}
schedule_priority = higher
{% else %}
{# A trend rule has no precise start time, so the scheduler may place it. #}
schedule_window = auto
{% endif %}
{# Alert actions apply to the result set, not to each result: an aggregated
   search produces one finding, and per-result actions are what turn one
   burst into eighty notifications. #}
alert.digest_mode = 1
{% if ai and ai.enabled %}
{# Native summary indexing rather than a collect in the search. collect is
   flagged by Splunk as a risky command, so opening the search from the UI
   prompts a warning; the action does the same write without it, and the
   rule's static metadata rides on the action instead of being recomputed
   per result. #}
action.summary_index = 1
action.summary_index._name = {{ ai.index | default('sigma_alerts') }}
action.summary_index.sigma_rule = {{ rule.title }}
action.summary_index.sigma_rule_id = {{ rule.rule_id }}
action.summary_index.sigma_level = {{ rule.level }}
action.summary_index.sigma_severity = {{ rule.severity }}
action.summary_index.sigma_confidence = {{ rule.confidence }}
action.summary_index.sigma_confidence_score = {{ rule.confidence_score }}
action.summary_index.sigma_disposition = {{ rule.disposition }}
action.summary_index.sigma_attack = {{ rule.mitre_techniques | join(',') }}
action.summary_index.sigma_tactic = {{ rule.mitre_tactics | join(',') }}
action.summary_index.sigma_platform = {{ rule.platform }}
action.summary_index.sigma_log_source = {{ rule.log_source }}
action.summary_index.sigma_status = {{ rule.status }}
{% if rule.author %}
action.summary_index.sigma_author = {{ rule.author }}
{% endif %}
{% if rule.references %}
action.summary_index.sigma_references = {{ rule.references }}
{% endif %}
{% if rule.falsepositives %}
action.summary_index.sigma_falsepositives = {{ rule.falsepositives }}
{% endif %}
{% if rule.modified or rule.rule_date %}
action.summary_index.sigma_rule_date = {{ rule.modified or rule.rule_date }}
{% endif %}
{% endif %}
cron_schedule = {{ config.cron_schedule | default('*/10 * * * *') }}
dispatch.earliest_time = {{ config.earliest_time | default('-10m') }}
dispatch.latest_time = {{ config.latest_time | default('now') }}
alert.severity = {{ rule.severity }}
alert.suppress = {{ config.suppress.enabled | default(0) }}
{% if config.suppress and config.suppress.enabled %}
alert.suppress.period = {{ config.suppress.period | default('1h') if rule.disposition == 'immediate' else (config.suppress.trend_period | default('24h')) }}
alert.suppress.fields = {{ config.suppress.fields | default('host') }}
{% endif %}
alert.track = 1
alert.expires = 24h
request.ui_dispatch_app = {{ config.app | default('sigma_detection_lab') }}
request.ui_dispatch_view = search
{% if rule.disposition == 'immediate' and config.alert_action and config.alert_action.email and config.alert_action.email.enabled %}
action.email = 1
action.email.to = {{ config.alert_action.email.to | default('ticketing@example.com') }}
action.email.subject.alert = Splunk Alert: $name$
action.email.useNSSubject = 1
action.email.message.alert = Use case $name$ triggered. MITRE techniques: {{ rule.mitre_techniques | join(', ') | default('none', true) }}. MITRE tactics: {{ rule.mitre_tactics | join(', ') | default('none', true) }}.{% if rule.fields %} Interesting fields: {% for field in rule.fields %}{{ field }}=$result.{{ field }}${% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}

{% else %}
action.email = 0
{% endif %}
{% endfor %}
