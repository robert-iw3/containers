# Copy to .env and set the values before the first start.
#
#   cp .env.example .env
#
# .env holds real credentials, so it stays out of version control. Confirm
# that with: git check-ignore -v splunk/.env

# Splunk admin password. The entrypoint refuses to start without it, because
# every first-start configuration command authenticates with it. Splunk 10
# enforces a minimum length of 8; longer is better and 'changeme' is refused.
SPLUNK_PASSWORD=

# Traefik dashboard credentials, bcrypt, dollar signs doubled for compose:
#   htpasswd -nbB admin 'a-real-password' | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_USERS=

# Where the forwarder sends. Defaults to the indexer in this compose file.
SPLUNK_FORWARD_SERVER=splunkenterprise.io:9997

# Resource limits. An indexer with no memory limit claims memory until the
# operating system pushes back.
SPLUNK_CPUS=2
SPLUNK_MEMORY=4g
UF_CPUS=1
UF_MEMORY=1g
TRAEFIK_CPUS=0.5
TRAEFIK_MEMORY=256m
