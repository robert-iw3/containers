# Generated by running the toolkit. None of it is source.
#
# assess/out holds assessment results, evidence bundles and checklists. The
# evidence is roughly 26 MB per run because the raw btool output is retained so
# a finding can be re-derived from it, and it is unredacted by design - it must
# never be committed.
assess/out/

# Byte-compiled Python from the build-time tools.
__pycache__/
*.pyc

# Development material: how the toolkit was built and proven, agent working data,
# superseded determinations. Useful to a maintainer, not part of the delivery.
internal_dev/
