# SRG-APP-000441-WSR-000181  -  CAT II
# The web server must maintain the confidentiality and integrity of
# information during preparation for transmission.
#
# Generated from the benchmark and the assessment determinations, then kept
# by hand. Edit this file to change how this requirement is assessed here;
# it is read at run time. Regenerating refreshes the benchmark text in place
# and leaves the criteria, the determination and any verification block as
# they are.

id:              SRG-APP-000441-WSR-000181
group:           V-206441
severity:        medium
cat:             CAT II
determination:   APPLICABLE
grade:           C
decidable:       machine
confidence:      documented
cci:             CCI-002420
control_rev5:    SC-8

contribution:    Before data leaves the instance Splunk can establish TLS to a verified
                 receiver with its own client certificate on a pinned version, require
                 indexer acknowledgment so that queued events are not discarded as sent,
                 and use TLS for the email alert action through either use_ssl for implicit
                 TLS or use_tls for STARTTLS.

governs:         alert_actions.conf - What Splunk does when an alert fires, such as sending email or calling a
                 webhook.
governs:         outputs.conf - Where this instance forwards its data, and how that connection is
                 protected.

check:           outputs.conf [tcpout:<target_group>] useSSL in true|1
check:           outputs.conf [tcpout:<group>] sslPassword non_empty
check:           outputs.conf [tcpout:<group>] sslVersions not_matches (^|[ ,])(\*|tls1\.0|tls1\.1|ssl3|tls)([ ,]|$)
check:           outputs.conf [tcpout:<group>] sslVerifyServerCert in 1|true
check:           outputs.conf [tcpout:<group>] useACK in 1|true
check:           alert_actions.conf [email] use_tls in 1|true (added alongside the existing sslVerifyServerCert in 1|true condition)
check:           alert_actions.conf [email] sslVersions matches ^\s*(tls1\.2|tls1\.3)(\s*,\s*(tls1\.2|tls1\.3))*\s*$
check:           outputs.conf [tcpout:<group>] sslVersions matches tls1\.[23]
# --- vendor verification: generated, do not edit by hand
corrected:       outputs.conf [tcpout:<group>] clientCert non_empty -> outputs.conf [tcpout:<target_group>] useSSL in true|1
corrected:       alert_actions.conf [email] sslVerifyServerCert in 1|true -> alert_actions.conf [email] use_tls in 1|true (added alongside the existing sslVerifyServerCert in 1|true condition)
corrected:       alert_actions.conf [email] sslVersions equals tls1.2 -> alert_actions.conf [email] sslVersions matches ^\s*(tls1\.2|tls1\.3)(\s*,\s*(tls1\.2|tls1\.3))*\s*$
vendor:          alert_actions.conf [email] sslVerifyServerCert https://help.splunk.com/en/splunk-enterprise/administer/admin-manual/10.4/configuration-file-reference/10.4.3-configuration-file-reference/alert_actions.conf
vendor:          alert_actions.conf [email] sslVersions https://help.splunk.com/en/splunk-enterprise/administer/admin-manual/10.4/configuration-file-reference/10.4.3-configuration-file-reference/alert_actions.conf
vendor:          outputs.conf [tcpout:<group>] clientCert https://help.splunk.com/en/splunk-enterprise/administer/manage-users-and-security/10.4/secure-splunk-platform-communications-with-transport-layer-security-certificates/configure-splunk-indexing-and-forwarding-to-use-tls-certificates
vendor:          outputs.conf [tcpout:<group>] sslPassword https://help.splunk.com/en/splunk-enterprise/administer/manage-users-and-security/10.4/secure-splunk-platform-communications-with-transport-layer-security-certificates/configure-splunk-indexing-and-forwarding-to-use-tls-certificates
vendor:          outputs.conf [tcpout:<group>] sslVerifyServerCert https://help.splunk.com/en/data-management/splunk-enterprise-admin-manual/10.4/configuration-file-reference/10.4.0-configuration-file-reference/outputs.conf
vendor:          outputs.conf [tcpout:<group>] sslVersions https://help.splunk.com/en/splunk-enterprise/administer/manage-users-and-security/10.4/secure-splunk-platform-communications-with-transport-layer-security-certificates/configure-tls-protocol-version-support-for-secure-connections-between-splunk-platform-instances
