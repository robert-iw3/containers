contribution:    Splunk defines distinct roles and grants each one named capabilities, so
                 the capabilities that change the product's own configuration, its
                 authentication, and its installed apps can be confined to administrative
                 roles and withheld from every other role.

governs:         authorize.conf - Used to create roles.

check:           authorize.conf [role_<roleName>] admin_all_objects absent
check:           authorize.conf [role_<roleName>] change_authentication absent
check:           authorize.conf [role_<roleName>] edit_httpauths absent
check:           authorize.conf [role_<roleName>] edit_local_apps absent
check:           limits.conf [system_checks] enable_install_apps equals true ; authorize.conf [role_user] install_apps absent ; authorize.conf [role_user] edit_local_apps absent ; authorize.conf [role_power] install_apps absent ; authorize.conf [role_power] edit_local_apps absent
check:           authorize.conf [role_<roleName>] importRoles present
