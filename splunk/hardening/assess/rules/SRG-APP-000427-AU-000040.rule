# SRG-APP-000427-AU-000040  -  CAT II
# The Central Log Server must only allow the use of DoW Public Key
# Infrastructure (PKI)-established certificate authorities for verification
# of the establishment of protected sessions.
#
# Generated from the benchmark and the assessment determinations, then kept
# by hand. Edit this file to change how this requirement is assessed here;
# it is read at run time. Regenerating refreshes the benchmark text in place
# and leaves the criteria, the determination and any verification block as
# they are.

id:              SRG-APP-000427-AU-000040
group:           V-221927
severity:        medium
cat:             CAT II
determination:   APPLICABLE
grade:           C
decidable:       machine
confidence:      documented
cci:             CCI-002470
control_rev5:    SC-23

contribution:    Splunk Enterprise can be pointed at a specific root certificate authority
                 store and a specific server certificate in place of the certificates it
                 auto-generates at first start, and it can be made to validate the
                 certificate presented by the far end on the connections it initiates and
                 to require a certificate from the clients that connect to it.
                 Configuration records which trust anchor and certificate files are in use;
                 it cannot record who issued them.

governs:         inputs.conf - Configures inputs, distributed inputs such as forwarders, and file system
                 monitoring.
governs:         outputs.conf - Where this instance forwards its data, and how that connection is
                 protected.
governs:         server.conf - Core server settings, including the certificates and protocols used to
                 protect management and replication traffic.
governs:         web.conf - Configures the Splunk Web interface.

check:           server.conf [sslConfig] sslRootCAPath non_empty
check:           server.conf [sslConfig] sslVerifyServerCert equals true
check:           outputs.conf [tcpout:<target_group>] sslVerifyServerCert in 1|true
check:           inputs.conf [splunktcp-ssl:<port>] requireClientCert in true|1
check:           web.conf [settings] sslVersions not_matches (^|,)\s*(ssl3|tls1\.0|tls1\.1|\*|tls)\s*(,|$)
check:           web.conf [settings] sslVersions matches (^|,)\s*tls1\.(2|3)\s*(,|$)
check:           server.conf [sslConfig] sslVersions matches ^[[:space:]]*(tls1\.2|tls1\.3)([[:space:]]*,[[:space:]]*(tls1\.2|tls1\.3))*[[:space:]]*$
check:           web.conf [settings] serverCert non_empty
check:           web.conf [settings] serverCert not_equals $SPLUNK_HOME/etc/auth/splunkweb/cert.pem
check:           server.conf [sslConfig] serverCert non_empty
# --- vendor verification: generated, do not edit by hand
corrected:       outputs.conf [tcpout] sslVerifyServerCert not_equals false -> outputs.conf [tcpout:<target_group>] sslVerifyServerCert in 1|true
corrected:       inputs.conf [splunktcp-ssl] requireClientCert not_equals false -> inputs.conf [splunktcp-ssl:<port>] requireClientCert in true|1
vendor:          inputs.conf [splunktcp-ssl] requireClientCert https://help.splunk.com/en/splunk-enterprise/administer/admin-manual/10.4/configuration-file-reference/10.4.2-configuration-file-reference/inputs.conf
vendor:          outputs.conf [tcpout] sslVerifyServerCert https://help.splunk.com/en/data-management/splunk-enterprise-admin-manual/10.4/configuration-file-reference/10.4.0-configuration-file-reference/outputs.conf
vendor:          server.conf [sslConfig] serverCert https://help.splunk.com/en/data-management/splunk-enterprise-admin-manual/10.4/configuration-file-reference/10.4.0-configuration-file-reference/server.conf
vendor:          server.conf [sslConfig] sslRootCAPath https://help.splunk.com/en/data-management/splunk-enterprise-admin-manual/10.4/configuration-file-reference/10.4.0-configuration-file-reference/server.conf
vendor:          server.conf [sslConfig] sslVerifyServerCert https://help.splunk.com/en/data-management/splunk-enterprise-admin-manual/10.4/configuration-file-reference/10.4.0-configuration-file-reference/server.conf
vendor:          web.conf [settings] serverCert https://help.splunk.com/en/splunk-enterprise/administer/admin-manual/10.4/configuration-file-reference/10.4.0-configuration-file-reference/web.conf
