# SRG-APP-000014-WSR-000006  -  CAT II
# The web server must use encryption strength in accordance with the
# categorization of data hosted by the web server when remote connections
# are provided.
#
# Generated from the benchmark and the assessment determinations, then kept
# by hand. Edit this file to change how this requirement is assessed here;
# it is read at run time. Regenerating refreshes the benchmark text in place
# and leaves the criteria, the determination and any verification block as
# they are.

id:              SRG-APP-000014-WSR-000006
group:           V-206352
severity:        medium
cat:             CAT II
determination:   APPLICABLE
grade:           C
decidable:       machine
confidence:      documented
revised:         yes
cci:             CCI-000068
control_rev5:    AC-17

contribution:    Splunk selects the TLS versions, cipher suites, and elliptic curves for
                 both the Splunk Web listener and the splunkd listener, and selects whether
                 the instance runs its cryptographic modules in FIPS mode; those settings
                 are the whole of the application's share of encryption strength.

governs:         server.conf - Core server settings, including the certificates and protocols used to
                 protect management and replication traffic.
governs:         splunk-launch.conf - Environment settings read before Splunk starts, including whether it
                 starts in FIPS mode.
governs:         web.conf - Configures the Splunk Web interface.

check:           splunk-launch.conf [] SPLUNK_FIPS in 1|true|t|yes (matched case-insensitively)
check:           web.conf [settings] enableSplunkWebSSL in 1|true
check:           web.conf [settings] cipherSuite matches ^((ECDHE|DHE)-(ECDSA|RSA)-AES(128|256)-(GCM-)?SHA(256|384))(:((ECDHE|DHE)-(ECDSA|RSA)-AES(128|256)-(GCM-)?SHA(256|384)))*$
check:           server.conf [sslConfig] sslVersionsForClient matches ^[[:space:]]*(tls1\.2|tls1\.3)([[:space:]]*,[[:space:]]*(tls1\.2|tls1\.3))*[[:space:]]*$
check:           server.conf [sslConfig] ecdhCurves non_empty
check:           web.conf [settings] sslVersions not_matches (^|,)\s*(ssl3|tls1\.0|tls1\.1|\*|tls)\s*(,|$)
check:           web.conf [settings] sslVersions matches (^|,)\s*tls1\.(2|3)\s*(,|$)
check:           server.conf [sslConfig] sslVersions matches ^[[:space:]]*(tls1\.2|tls1\.3)([[:space:]]*,[[:space:]]*(tls1\.2|tls1\.3))*[[:space:]]*$
