id:              SRG-APP-000141-WSR-000083
group:           V-206382
severity:        medium
cat:             CAT II
determination:   APPLICABLE
grade:           C
decidable:       machine
confidence:      documented
cci:             CCI-000381
control_rev5:    CM-7

contribution:    Splunk Web serves static content only from a declared directory beneath a
                 declared endpoint, and it can be kept from generating a directory listing,
                 so the files it will return are limited to those the views reference
                 rather than whatever the directory holds.

governs:         web.conf - Configures the Splunk Web interface.

check:           web.conf [settings] tools.staticdir.generate_indexes in 0|false
check:           web.conf [settings] static_dir present
# --- vendor verification: generated, do not edit by hand
vendor:          web.conf [settings] static_dir https://help.splunk.com/en/splunk-enterprise/administer/admin-manual/10.4/configuration-file-reference/10.4.0-configuration-file-reference/web.conf
