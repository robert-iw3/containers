# Copy to .env and set the values before the first start.
#
#   cp .env.example .env
#
# .env holds real credentials and stays out of version control.

# Authenticates the leader/worker channel, which carries the whole config
# bundle including every Destination credential. Cribl's own default token is
# public knowledge, so this has no default and the stack refuses to start
# without it:
#
#   openssl rand -hex 24
CRIBL_DIST_TOKEN=

# The image. Both the tag and the tarball in Dockerfile track the same
# version; ci/cribl-release-check.sh verifies they agree and resolve.
CRIBL_IMAGE=docker.io/cribl/cribl:4.19.2

# Web UI, bound to the loopback. First-boot credentials are admin/admin.
CRIBL_UI_PORT=19000

# Resource limits. Cribl sizes its worker processes to the machine it can
# see, so an unbounded container on a many-core host takes the host with it.
LEADER_CPUS=2
LEADER_MEMORY=4g
WORKER_CPUS=2
WORKER_MEMORY=4g
