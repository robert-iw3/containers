{
  "id": "{{pipeline_id}}",
  "description": "MS-SQL rows pipeline: enrich, mask sensitive values, aggregate per query type, sample.",
  "conf": {
    "asyncFuncTimeout": 1000,
    "output": "{{main_output}}",
    "functions": [
      {"id": "eval", "filter": "true", "disabled": false, "conf": {"add": [{"name": "source", "value": "'{{source_tag}}'"}, {"name": "index_time", "value": "Date.now()"}]}, "description": "Enrich with provenance metadata"},
      {"id": "mask", "filter": "true", "disabled": false, "conf": {"rules": [{"matchRegex": "/\"(sensitive_[^\"]+)\"\\s*:\\s*\"[^\"]*\"/g", "replaceExpr": "`\"${g1}\": \"***MASKED***\"`"}], "fields": ["_raw"]}, "description": "Mask sensitive_* values"},
      {"id": "aggregation", "filter": "true", "disabled": false, "conf": {"timeWindow": "{{aggregate_interval}}", "aggregations": ["count().as(event_count)"], "groupbys": ["query_type"], "passthrough": true}, "description": "Rolling per-category counts (passthrough)"},
      {"id": "sampling", "filter": "true", "disabled": false, "conf": {"rules": [{"filter": "true", "rate": {{sample_rate}}}]}, "description": "Keep 1 in {{sample_rate}} events"}
    ]
  }
}
