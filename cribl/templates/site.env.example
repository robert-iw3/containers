# Site-specific values for a Cribl -> Splunk integration. Everything NOT in this
# file is portable: the record formats these pipelines parse are set by the
# vendor, not by your site, so the rules themselves do not change between
# environments.
#
#   cp site.env.example site.env    then edit, then ./render.sh out/
#
# site.env is gitignored. Never commit a HEC token.

# ---------------------------------------------------------------- destination
# hec  = Splunk HTTP Event Collector. Simplest to configure. Works with any
#        Splunk deployment that has HEC enabled.
# s2s  = Splunk-to-Splunk (splunk_lb). Sends cooked, parsed data. The indexer
#        then skips line-breaking and timestamp extraction, which lowers its
#        CPU cost at high volume.
CRIBL_DEST_TYPE=hec

# HEC. The URL must use https. Splunk ships HEC with enableSSL=1, so an http://
# URL fails: the client reads a TLS record where it expected a status line.
CRIBL_HEC_URL=https://splunk.example.internal:8088/services/collector/event
CRIBL_HEC_TOKEN=REPLACE-WITH-A-REAL-TOKEN

# S2S. Used only when CRIBL_DEST_TYPE=s2s. Comma-separated host:port.
CRIBL_S2S_HOSTS=idx01.example.internal:9997,idx02.example.internal:9997

# Verify the indexer's certificate. Set false ONLY for a lab with a self-signed
# certificate, and say so in the change record.
CRIBL_TLS_VERIFY=true

# ------------------------------------------------------------------- indexing
# Where reduced data lands. One index per data class is the usual shape; a
# single index is fine to start and is what these templates assume.
SPLUNK_INDEX_DEFAULT=main
SPLUNK_INDEX_WINDOWS=win
SPLUNK_INDEX_NETWORK=net
SPLUNK_INDEX_IDENTITY=identity
SPLUNK_INDEX_APP=app

# ------------------------------------------------------------------- listeners
# Ports the workers open. Do not publish any of them from the container;
# senders reach the workers on the workers' own network.
CRIBL_PORT_SYSLOG=9514
CRIBL_PORT_TCPJSON=10060
CRIBL_PORT_SPLUNK_S2S=9997
CRIBL_PORT_HEC=8088

# ------------------------------------------------------------------------ TLS
# Paths INSIDE the worker container. Cribl runs as root there, so a read-only
# bind mount at these paths is readable with no further setup. Splunk differs:
# splunkd runs as the splunk user, so certificates have to be staged first.
CRIBL_TLS_CA=/opt/cribl/certs/ca.crt
CRIBL_TLS_CERT=/opt/cribl/certs/worker.crt
CRIBL_TLS_KEY=/opt/cribl/certs/worker.key
# Regex a sender's certificate common name must match. /.*/ accepts any cert the
# CA signed; on an ingest port, match only the sender names you expect.
CRIBL_TLS_CN_REGEX='/^.*\.example\.internal$/'

# ----------------------------------------------------------- reduction tuning
# Review these values before deployment. The rules are portable; the rates
# are not. Each is "keep one in N". Set them from your own event volume, not
# from these defaults. COVERAGE.md records the visibility each rate gives up.
RATE_FW_ALLOWED_SESSIONS=10      # firewall: allowed sessions. Denies and threats are never sampled.
RATE_DNS_COMMON_NAMES=10         # DNS: names matched by DNS_ALLOWLIST_REGEX below.
RATE_NETFLOW=20                  # netflow: everything. Consider routing to object storage instead.
RATE_IDS_FLOW=10                 # suricata: flow records. Alerts are never sampled.
RATE_IDS_HTTP=4                  # suricata: http records.
RATE_PROXY_SUCCESS=3             # proxy: successful misses. Denials are never sampled.
RATE_WEB_SUCCESS=4               # web tier: 2xx/3xx that survive the static-asset drop.
RATE_SYSMON_NETCONN=5            # sysmon: EventID 3. Process, file and DNS events are never sampled.
RATE_ASA_SESSIONS=10             # ASA: connection build and teardown. VPN and denies are never sampled.

# Names that most hosts in the environment resolve routinely. Anything NOT
# matching this regex is kept in full, so rare names remain searchable.
# Add your own update, telemetry and CDN domains; do not add a wildcard.
DNS_ALLOWLIST_REGEX='(windowsupdate|microsoft\.com|office365|teams\.microsoft|time\.windows|akamai|cloudfront)'

# Your internal address space. The quarantine route uses it to distinguish
# internal senders from senders outside this space.
INTERNAL_CIDR_REGEX='^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)'
