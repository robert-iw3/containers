OPENSEARCH_VERSION=3.2.0
DASHBOARDS_VERSION=3.2.0

# Initial password for the built-in `admin` user (used by the security plugin,
# health checks, and dashboards). Must meet the OpenSearch password policy
# (>=8 chars, upper/lower/digit/special). Generate with: openssl rand -base64 16
OPENSEARCH_INITIAL_ADMIN_PASSWORD='changeme-Str0ng!'

# Password the dashboards server uses to connect to OpenSearch (kibanaserver user).
OPENSEARCH_DASHBOARDS_PASSWORD='changeme-Str0ng!'
