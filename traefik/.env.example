# Copy to .env and adjust. The UAT generates its own uat/.env; these values are
# for running the compose stack directly.
PROXY_IMAGE=docker.io/traefik:v3.7
BIND_ADDR=127.0.0.1
TLS_PORT=8443
HTTP_PORT=8080
# Directory holding tls.crt / tls.key the proxy serves. Generate a pair into
# uat/tls with uat/run-uat.sh, or point this at your own certificate directory.
TLS_DIR=./uat/tls
COMPOSE_NET_NAME=traefik-proxy-net
