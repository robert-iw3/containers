# {{ ansible_managed }}
# SCRAM-SHA-256 for every connection; remote access scoped to the stack's
# private subnet.
# TYPE  DATABASE  USER  ADDRESS          METHOD
local   all       all                    scram-sha-256
host    all       all   127.0.0.1/32     scram-sha-256
host    all       all   ::1/128          scram-sha-256
host    all       all   {{ net_subnet }} scram-sha-256
