# Copy to .env and replace every placeholder before deploying.
#   cp .env.example .env && chmod 600 .env
# Or generate everything (.env, tinyauth.env, realm, TLS) from stack.yaml:
#   scripts/render.sh

# --- Network -------------------------------------------------------------
COMPOSE_NET_NAME=sonar-stack
# Keep NET_SUBNET in sync with postgres/pg_hba.conf.
NET_SUBNET=172.31.20.0/24
TRAEFIK_IP=172.31.20.10

# --- Published endpoint --------------------------------------------------
# TLS_PORT must equal traefik's internal entrypoint (8443) so the Keycloak
# issuer URL is identical for the browser and tinyauth's backchannel.
BIND_ADDR=0.0.0.0
TLS_PORT=8443
APP_HOST=sonarqube.example.com
AUTH_HOST=sso.sonarqube.example.com
KEYCLOAK_HOST=keycloak.example.com
TLS_DIR=/etc/ssl/sonar-stack
DOCKER_SOCKET=/var/run/docker.sock

# --- Keycloak ------------------------------------------------------------
KEYCLOAK_REALM=sonar
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- tinyauth ------------------------------------------------------------
# 32 characters: openssl rand -hex 16
TINYAUTH_SECRET=CHANGE_ME_32_CHARACTER_SECRET___
# The Keycloak OIDC client secret lives in tinyauth.env (GENERIC_CLIENT_ID /
# GENERIC_CLIENT_SECRET) and must match the client in the imported realm.

# --- SonarQube -----------------------------------------------------------
SONAR_DB_PASSWORD=CHANGE_ME
