# Copy to terraform.tfvars and adjust. Authenticate with `az login` first.

location    = "eastus"
name_prefix = "hashistack"

# REQUIRED: lock admin access down to your own address, e.g. "203.0.113.7/32"
allowed_admin_cidrs = []

# REQUIRED
admin_ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

vm_size          = "Standard_B2s"
consul_servers   = 3
vault_servers    = 3
boundary_workers = 1

db_sku = "B_Standard_B1ms"

tags = {
  environment = "uat"
}
