# Copy to terraform.tfvars and adjust. Authenticate with
# `gcloud auth application-default login` first, and enable the
# compute, cloudkms, sqladmin, and servicenetworking APIs.

project_id  = "my-project"
region      = "us-central1"
zone        = "us-central1-a"
name_prefix = "hashistack"

# REQUIRED: lock admin access down to your own address, e.g. "203.0.113.7/32"
allowed_admin_cidrs = []

machine_type     = "e2-small"
consul_servers   = 3
vault_servers    = 3
boundary_workers = 1

db_tier = "db-f1-micro"

labels = {
  environment = "uat"
}
