# Copy to .env. These are LOCAL DEVELOPMENT DEFAULTS — replace the
# password (and mirror it in config.yml database.password) before any
# non-local deployment.

# PostgreSQL (official postgres image variable names; consumed via env_file)
POSTGRES_USER=hanko
POSTGRES_PASSWORD=hanko-dev-password
POSTGRES_DB=hanko

# Hanko backend image (upstream release; override for locally built images)
HANKO_IMAGE=ghcr.io/teamhanko/hanko
HANKO_TAG=v2.7.0

# Locally built elements frontend (see frontend/frontend.Dockerfile)
CONTAINER_REGISTRY=localhost
TAG=latest
