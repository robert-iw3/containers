# Copy to .env and replace every placeholder before deploying.
#   cp .env.example .env && chmod 600 .env

# --- Network -------------------------------------------------------------
COMPOSE_NET_NAME=confluence-sso
NET_SUBNET=172.31.17.0/24
TRAEFIK_IP=172.31.17.10

# --- Published endpoint --------------------------------------------------
BIND_ADDR=0.0.0.0
TLS_PORT=443
APP_HOST=confluence.example.com
AUTH_HOST=sso.confluence.example.com
TLS_DIR=/etc/ssl/confluence-sso
DOCKER_SOCKET=/var/run/docker.sock

# --- tinyauth ------------------------------------------------------------
# 32 characters: openssl rand -hex 16
TINYAUTH_SECRET=CHANGE_ME_32_CHARACTER_SECRET___
TINYAUTH_APP_URL=https://sso.confluence.example.com
# Local users (htpasswd -nbB alice 'password'), or use OIDC via
# sso/tinyauth.env — see ci/sso/tinyauth-oidc.env.example.
TINYAUTH_USERS=CHANGE_ME

# --- Confluence ----------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
CONFLUENCE_JVM_MINIMUM_MEMORY=1024m
CONFLUENCE_JVM_MAXIMUM_MEMORY=2048m
# Completing setup past the wizard requires an Atlassian licence key, entered
# in the browser wizard. Without it the stack reaches the licence step and
# stops.
