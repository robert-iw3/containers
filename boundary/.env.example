# Copy to .env (or run ./scripts/bootstrap-env.sh to generate random values).
# All values are consumed at container start; nothing is baked into the image.

POSTGRES_USER=boundary
POSTGRES_PASSWORD=change-me
POSTGRES_DB=boundary

# base64-encoded 256-bit AEAD keys: openssl rand -base64 32
BOUNDARY_ROOT_KEY=change-me
BOUNDARY_WORKER_AUTH_KEY=change-me
BOUNDARY_RECOVERY_KEY=change-me

# address clients use to reach the worker session proxy (9202)
BOUNDARY_PUBLIC_HOST=127.0.0.1
