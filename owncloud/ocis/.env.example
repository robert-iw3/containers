# Copy to .env and fill in every value before first start.

# Public FQDN oCIS is served on (must resolve to this host).
OCIS_HOSTNAME=ocis.example.com
# Email used for Let's Encrypt registration/expiry notices.
ACME_EMAIL=admin@example.com
# Initial admin password (user: admin). Change after first login.
OCIS_ADMIN_PASSWORD=
# Pin to a specific release in production, e.g. 7.0.0.
OCIS_VERSION=7.0.0
# Log level: panic, fatal, error, warn, info, debug, trace
OCIS_LOG_LEVEL=warn
