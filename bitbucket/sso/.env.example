# Copy to .env and replace every placeholder before deploying.
#   cp .env.example .env && chmod 600 .env

# --- Network -------------------------------------------------------------
COMPOSE_NET_NAME=bitbucket-sso
NET_SUBNET=172.31.16.0/24
TRAEFIK_IP=172.31.16.10

# --- Published endpoint --------------------------------------------------
BIND_ADDR=0.0.0.0
TLS_PORT=443
APP_HOST=bitbucket.example.com
AUTH_HOST=sso.bitbucket.example.com
TLS_DIR=/etc/ssl/bitbucket-sso
DOCKER_SOCKET=/var/run/docker.sock

# --- tinyauth ------------------------------------------------------------
# 32 characters: openssl rand -hex 16
TINYAUTH_SECRET=CHANGE_ME_32_CHARACTER_SECRET___
TINYAUTH_APP_URL=https://sso.bitbucket.example.com
# Local users (htpasswd -nbB alice 'password'), or use OIDC via
# sso/tinyauth.env — see ci/sso/tinyauth-oidc.env.example.
TINYAUTH_USERS=CHANGE_ME

# --- Bitbucket -----------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
BITBUCKET_JVM_MINIMUM_MEMORY=1024m
BITBUCKET_JVM_MAXIMUM_MEMORY=2048m
# Completing setup past the wizard requires an Atlassian licence key, which
# is entered in the browser wizard (or seeded through Bitbucket's own
# automation). Without it the stack reaches the licence step and stops.
