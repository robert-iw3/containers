# Copy to .env (or run ./scripts/bootstrap-env.sh to generate random values).
# Consumed at container start; nothing is baked into images.

# MinIO object-storage credentials (also injected into Milvus as its
# storage access key/secret).
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Milvus root password. milvus-init rotates the factory default ("Milvus")
# to this value on first start.
MILVUS_ROOT_PASSWORD=change-me
