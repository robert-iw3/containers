# Copy to .env and replace every placeholder before deploying.
#   cp .env.example .env && chmod 600 .env

# --- Network -------------------------------------------------------------
COMPOSE_NET_NAME=gitea-sso
NET_SUBNET=172.31.11.0/24
TRAEFIK_IP=172.31.11.10

# --- Published endpoint --------------------------------------------------
BIND_ADDR=0.0.0.0
TLS_PORT=443
APP_HOST=gitea.example.com
AUTH_HOST=sso.gitea.example.com
TLS_DIR=/etc/ssl/gitea-sso
DOCKER_SOCKET=/var/run/docker.sock

# --- tinyauth ------------------------------------------------------------
# 32 characters: openssl rand -hex 16
TINYAUTH_SECRET=CHANGE_ME_32_CHARACTER_SECRET___
TINYAUTH_APP_URL=https://sso.gitea.example.com
# Local users (htpasswd -nbB alice 'password'), or use OIDC via
# sso/tinyauth.env — see ci/sso/tinyauth-oidc.env.example.
TINYAUTH_USERS=CHANGE_ME

# --- Gitea ---------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
# Internal signing key: gitea generate secret SECRET_KEY
GITEA_SECRET_KEY=CHANGE_ME
