# Copy to .env and replace every placeholder before deploying.

# --- Core -----------------------------------------------------------------
PORT=3000
ADDRESS=0.0.0.0
# Session signing secret, exactly 32 characters:
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
SECRET=CHANGE_ME_32_CHARACTER_SECRET___
# Public URL users are redirected to for login
APP_URL=https://tinyauth.example.com
# user:bcrypt-hash pairs, comma separated. Generate with:
#   podman run --rm ghcr.io/steveiliop56/tinyauth:v3.6.2 user create --interactive
USERS=CHANGE_ME
COOKIE_SECURE=true
APP_TITLE=Tinyauth SSO
SESSION_EXPIRY=7200
LOGIN_TIMEOUT=300
LOGIN_MAX_RETRIES=5
LOG_LEVEL=0

# --- Compose-level settings (used by example.docker-compose.yml) ----------
TRAEFIK_DOMAIN=traefik.example.com
TINYAUTH_DOMAIN=tinyauth.example.com
WHOAMI_DOMAIN=whoami.example.com
LETSENCRYPT_EMAIL=your.email@example.com
DOCKER_SOCKET=/var/run/docker.sock
# Rootless podman:
#DOCKER_SOCKET=/run/user/1000/podman/podman.sock

# --- Optional OAuth providers (leave unset to disable) --------------------
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GENERIC_NAME=My OAuth
#GENERIC_CLIENT_ID=
#GENERIC_CLIENT_SECRET=
#GENERIC_SCOPES=
#GENERIC_AUTH_URL=
#GENERIC_TOKEN_URL=
#GENERIC_USER_URL=
#GENERIC_SKIP_SSL=false
#OAUTH_WHITELIST=
#OAUTH_AUTO_REDIRECT=none
