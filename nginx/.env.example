# Copy to .env and adjust. The UAT generates its own uat/.env; these values are
# for running the compose stack directly.
PROXY_IMAGE=docker.io/library/nginx:1.29-alpine
BIND_ADDR=127.0.0.1
TLS_PORT=8443
HTTP_PORT=8080
# Directory holding tls.crt / tls.key. Run uat/run-uat.sh once to generate a
# pair into uat/tls, or point this at your own certificate directory.
TLS_DIR=./uat/tls
COMPOSE_NET_NAME=nginx-proxy-net
