# Copy to .env and replace every placeholder before deploying.
#   cp .env.example .env && chmod 600 .env

# --- Network -------------------------------------------------------------
COMPOSE_NET_NAME=salt-sso
NET_SUBNET=172.31.15.0/24
TRAEFIK_IP=172.31.15.10

# --- Published endpoint --------------------------------------------------
BIND_ADDR=0.0.0.0
TLS_PORT=443
APP_HOST=salt.example.com
AUTH_HOST=sso.salt.example.com
TLS_DIR=/etc/ssl/salt-sso
DOCKER_SOCKET=/var/run/docker.sock

# --- tinyauth ------------------------------------------------------------
# 32 characters: openssl rand -hex 16
TINYAUTH_SECRET=CHANGE_ME_32_CHARACTER_SECRET___
TINYAUTH_APP_URL=https://sso.salt.example.com
# Local users (htpasswd -nbB alice 'password'), or use OIDC via
# sso/tinyauth.env — see ci/sso/tinyauth-oidc.env.example.
TINYAUTH_USERS=CHANGE_ME

# --- salt-api eauth ------------------------------------------------------
# The sharedsecret eauth username and secret used to obtain salt tokens.
SALT_API_USER=saltapi
SALT_SHARED_SECRET=CHANGE_ME
