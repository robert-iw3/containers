# SQL stack settings.  cp .env.example .env  (git-ignored)
# Generate strong secrets, e.g.:  openssl rand -base64 24

# SA password for every SQL Server shard (8+ chars, upper/lower/digit/symbol).
SQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# HMAC secret for gateway JWTs. The gateway refuses to start without it.
JWT_SECRET=ChangeMe_jwt_secret_use_openssl_rand

# Redis auth (shard mapping + global rate-limit store).
REDIS_PASSWORD=ChangeMe_redis_password

# Application database created on each shard.
APP_DB=AppDb

# --- optional tuning ---
# Published address for the gateway (loopback by default).
#GATEWAY_PUBLISHED_ADDR=0.0.0.0:3000
# In-process workers per container (1 = single process; scale via replicas).
#CLUSTER_WORKERS=1
# Per-shard connection pool sizing.
#SQL_POOL_MAX=20
#SQL_POOL_MIN=2
# Global rate limit (requests per window per client IP).
#RATE_LIMIT_MAX=100
#RATE_LIMIT_WINDOW_MS=60000
# Guarded raw SQL path (admin/migrations). 0 = disabled (default).
#GATEWAY_ALLOW_RAW_SQL=0
# When raw SQL is enabled, restrict to SELECT/WITH (1 = read-only, default).
#GATEWAY_RAW_SQL_READONLY=1
