# Copy to .env and fill in. Generate FERNET with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Set AIRFLOW_UID to your host uid (`id -u`) so files written to ./logs are yours.
AIRFLOW_UID=50000
POSTGRES_PASSWORD=change-me
AIRFLOW__CORE__FERNET_KEY=change-me-fernet
AIRFLOW__API_AUTH__JWT_SECRET=change-me-jwt-secret
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Fully-qualified so it also works under rootless podman (needs the docker.io/ prefix).
AIRFLOW_IMAGE_NAME=docker.io/apache/airflow:3.3.0
