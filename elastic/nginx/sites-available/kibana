upstream elasticsearch {
    server elasticsearch:9200;
    keepalive 15;
  }

upstream kibana {
    server kibana:5601;
    keepalive 15;
  }

server {

  listen 443 ssl;
  server_name elastic-lab.io;

  ssl_certificate /path/to/your/kibana.crt;
  ssl_certificate_key /path/to/your/kibana.key;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:50m;
  ssl_ciphers 'YOUR-CIPHER-SUITE';
  ssl_dhparam /etc/nginx/dhparam.pem;

  auth_basic "Your Company Restricted Area";
  auth_basic_user_file /path/to/your/basicauth.htpasswd;

  # The stack backends are TLS; trust the stack CA mounted at /certs/ca/ca.crt.
  proxy_ssl_trusted_certificate /certs/ca/ca.crt;
  proxy_ssl_verify on;

  # Elasticsearch
  location / {

    proxy_pass https://elasticsearch;
    proxy_redirect off;
    proxy_buffering off;

    proxy_http_version 1.1;
    proxy_set_header Connection "Keep-Alive";
    proxy_set_header Proxy-Connection "Keep-Alive";

  }

  # Kibana
  location /kibana/ {

    proxy_pass https://kibana;
    proxy_redirect off;
    proxy_buffering off;

    proxy_http_version 1.1;
    proxy_set_header Connection "Keep-Alive";
    proxy_set_header Proxy-Connection "Keep-Alive";

    rewrite ^/kibana/(.*)$ /$1 break;

  }

}
