# Copy to .env and fill in every value before first start.
# Generate strong secrets:  openssl rand -base64 32

# ---------------------------------------------------------------------------
# Domain / TLS
# ---------------------------------------------------------------------------
# Public FQDN Nextcloud is served on (must resolve to this host).
NEXTCLOUD_HOSTNAME=nextcloud.example.com
# Email used for Let's Encrypt registration/expiry notices.
ACME_EMAIL=admin@example.com
# Hostname for the Traefik dashboard (protected by basic auth).
TRAEFIK_HOSTNAME=traefik.example.com
# Basic-auth user for the Traefik dashboard, htpasswd/apr1/bcrypt format.
# Generate: htpasswd -nB traefikadmin   (or: openssl passwd -apr1 <password>)
# Paste the hash as-is — do NOT escape '$' in .env values.
TRAEFIK_BASIC_AUTH=traefikadmin:$2y$05$REPLACE_WITH_BCRYPT_HASH
# Published ports (lower to 8081/8443 for rootless podman or local testing).
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
# Container engine API socket for Traefik service discovery.
# Docker: /var/run/docker.sock   Rootless podman: /run/user/<uid>/podman/podman.sock
DOCKER_SOCKET=/var/run/docker.sock

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Nextcloud
# ---------------------------------------------------------------------------
# Only used for the very first install (bootstrap admin account).
NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=
# Space-separated list of domains Nextcloud will answer on.
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.example.com
# CIDRs of reverse proxies allowed to set X-Forwarded-* (compose network below).
TRUSTED_PROXIES=172.28.0.0/16
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://nextcloud.example.com
# PHP tuning (also baked into the image defaults).
PHP_MEMORY_LIMIT=1024M
PHP_UPLOAD_LIMIT=10G

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# How long the backup sidecar waits before its first run.
BACKUP_INIT_SLEEP=1800
# Interval between backup runs (sleep(1) syntax).
BACKUP_INTERVAL=24h
# Days to keep database / data archives before pruning.
BACKUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Optional: Collabora Online (profile "office")
# ---------------------------------------------------------------------------
COLLABORA_HOSTNAME=office.example.com
# Escape special regex chars, e.g. nextcloud\.example\.com
COLLABORA_ALIASGROUP=https://nextcloud\.example\.com:443
COLLABORA_ADMIN_USER=cooladmin
COLLABORA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: Authelia SSO (profile "sso")
# Authelia is the OpenID Connect provider for Nextcloud (via the user_oidc app)
# and forward-auth for the Traefik dashboard. Bootstrap secrets first —
# see authelia/README.md — then run ./nextcloud-configure-oidc.sh.
# Use with:  -f docker-compose.yml -f docker-compose.sso.yml --profile sso
# ---------------------------------------------------------------------------
AUTHELIA_HOSTNAME=auth.example.com
# Public URL of the Authelia portal (this is also the OIDC issuer).
AUTHELIA_URL=https://auth.example.com
# Parent domain the Authelia session cookie is scoped to (must cover the auth
# host and any forward-auth-protected host, e.g. the Traefik dashboard).
AUTHELIA_COOKIE_DOMAIN=example.com
# Set this to gate the Traefik dashboard behind Authelia instead of basic-auth.
TRAEFIK_DASHBOARD_MIDDLEWARE=authelia-fwd@docker

# OIDC client shared between Authelia and Nextcloud's user_oidc app.
OIDC_NEXTCLOUD_CLIENT_ID=nextcloud
# Where Nextcloud receives the auth code (host must match NEXTCLOUD_HOSTNAME).
NEXTCLOUD_OIDC_REDIRECT_URI=https://nextcloud.example.com/apps/user_oidc/code
OIDC_PROVIDER_NAME=Authelia
# Plaintext client secret (used by Nextcloud). Generate: openssl rand -hex 32
OIDC_NEXTCLOUD_CLIENT_SECRET=
# pbkdf2 hash of the SAME secret (used by Authelia). Generate:
#   docker run --rm authelia/authelia:4.38 \
#     authelia crypto hash generate pbkdf2 --variant sha512 --password "$OIDC_NEXTCLOUD_CLIENT_SECRET"
OIDC_NEXTCLOUD_CLIENT_SECRET_HASH=

# ---------------------------------------------------------------------------
# Compose network (only change on subnet collisions)
# ---------------------------------------------------------------------------
NEXTCLOUD_SUBNET=172.28.0.0/16
