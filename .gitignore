*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
.coverage
htmlcov/

ansible_runner_output/
artifacts/
*.retry

reports/
!gotestwaf/reports/.gitignore

.env
*.log

.vagrant/
nomad/baremetal/.generated/
.nomad-deploy/
*.tfstate
*.tfstate.*
.terraform/
*.auto.tfvars.json
.tfplan
nomad/terraform/lambda/*.zip

api-firewall/certs/*
