__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
.coverage
htmlcov/

ansible_runner_output/
artifacts/
*.retry

reports/
!gotestwaf/reports/.gitignore

.env
*.log

.vagrant/
nomad/baremetal/.generated/
.nomad-deploy/
*.tfstate
*.tfstate.*
.terraform/
*.auto.tfvars.json
.tfplan
nomad/terraform/lambda/*.zip

api-firewall/certs/*
!api-firewall/certs/.gitkeep
api-firewall/crs/*
!api-firewall/crs/.gitkeep

# generated by smoke-test.sh / export_spec.py
api-firewall/integrations/sql-backend/openapi.json
api-firewall/uat/openapi.json

# hashicorp stacks: generated local secrets
vault/.vault-init.json
integration-demos/hashicorp-stack/.demo-state/
consul/.consul-bootstrap.json
boundary/.boundary-admin.json
integration-demos/hashicorp-stack/.boundary-admin.json
backstage/.boundary-admin.json
.env.bak*

# cribl demo: runtime state written into the bind-mounted config dir
cribl/demo/config/auth/
cribl/demo/config/cribl.inited
cribl/demo/config/*.yml.bak
cribl/demo/output/*
!cribl/demo/output/.gitkeep

# local-only copybara sync tooling; never committed or mirrored
copybara/

# backstage portal stack: extracted demo CA + admin creds
backstage/.portal-ca.crt
backstage/production-deploy/hosts.env
backstage/portal-diagnostics-*.tar.gz

# auth stacks: local secrets, generated certs and runtime state
*.vault_pass.txt
freeipa/playbook_sensitive_data.yml
freeipa/freeipa-k8s-deploy.yaml
hanko/tls/
tinyauth/letsencrypt/
authentik/media/
authentik/certs/
authentik/custom-templates/

# auth stack UAT runtime state (generated by each uat/run-uat.sh)
*/uat/.uat-password
*/uat/.uat-demo-password
*/uat/.totp-hexkey
*/uat/tls/
*/uat/oauth2-proxy.env
freeipa/uat/ipa-data/
hanko/uat/config-uat.yml

# devops SSO stacks: deployed secrets and identity-provider settings
# (generated .env is already covered by the global .env rule above)
*/sso/tinyauth.env
*/uat/.sso-cookie

# sonarqube full stack (keycloak): generated secrets, realm, TLS, state
sonarqube/stack/tinyauth.env
sonarqube/stack/keycloak/realm-sonar.json
sonarqube/stack/.demo-password
sonarqube/stack/tls/
sonarqube/stack/ansible/.secrets/
sonarqube/stack/ansible/files/tls/*.crt
sonarqube/stack/ansible/files/tls/*.key

# networking stacks (coredns, proxies, VPN): deployed secrets and TLS material
# (generated .env and */uat/tls/ are already covered above)
*/ansible/.secrets/
*/ansible/files/tls/*.crt
*/ansible/files/tls/*.key
*/ansible/files/keys/
wireguard/ansible/.secrets/
wireguard/uat/wg/
wireguard/uat/.we-loaded-wg
tailscale/ansible/.secrets/
defguard/uat/certs/

# secure_browser: packed image tarballs (rebuild with secure_browser/pack.sh)
secure_browser/images/

# splunk: ansible vault password and connector test artefacts
splunk/quick_deploy/ansible/vault_pass.txt
splunk/splunk__connectors/uat/work/
splunk/splunk__connectors/uat/fixtures/
splunk/splunk__connectors/*/rust/target/
splunk/splunk__connectors/*/rust/build.log

# cribl: runtime state Cribl writes into the mounted config directories.
# auth/ holds cribl.secret and the admin password hash.
cribl/leader-config/auth/
cribl/leader-config/cribl.inited
cribl/leader-config/groups.yml
cribl/leader-config/messages.yml
cribl/demo/output/*.json
cribl/demo/output/**/*.json

# Generated secrets and key material. These are produced by running a stack,
# never authored, so they must not be committed. A committed private key stays
# in git history after deletion, so anything matched here that was previously
# tracked must also be rotated.
**/auth/cribl.secret
**/auth/users.json
**/auth/*.dat
**/auth/certs/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
id_rsa
id_ed25519
*.htpasswd
# Certificates are public, but these directories only ever hold generated
# material and the key sits beside the cert.
cribl/certs/*
!cribl/certs/.gitignore
splunk/secrets/
# Deployable output of splunk/conf/render.sh, plus the certificates it points
# at. Both are per-deployment and one of them is private keys.
splunk/conf-rendered/
splunk/certs/

# Exceptions to the key-material rules above. These are PUBLIC trust stores
# shipped inside vendored applications, not generated secrets: ignoring them
# silently breaks TLS verification in those apps the next time one is updated.
!**/certifi/cacert.pem
!opensearch/data-prepper/config/default-keystore.p12

# cribl pipelines: the docs tell operators to put the Cribl admin password,
# the database password and the HEC token in config.ini. Only the example is
# tracked, so editing the real one cannot commit a credential.
cribl/custom-pipelines/*/config/config.ini
cribl/integration-lab/work/
cribl/integration-lab/cribl-config/leader/
cribl/integration-lab/cribl-config/groups/*/auth/

# Planning and exploration, not deliverables. Work in here is unfinished by
# definition and is kept out of the tree so the docs that ship are only the
# ones that describe something that works.
cribl/docs/planning/

# Untracked working notes and planning documents, any depth
planning/

# Splunk integrations working inputs: large, or re-fetchable on demand.
# Add-on packages come from Splunkbase, rule sets from fetch-rules.py,
# and pylib from pip, so none of it belongs in the repository.
splunk/integrations/datagen/addons/Splunk_TA_*/
splunk/integrations/sigma/pylib/
splunk/integrations/sigma/rules/

# Built from the fetched rule set by sigma/bin/build-engine.py. The
# ATT&CK technique names beside them are not derived from the rules and
# are kept, because the target environment has no internet access.
splunk/integrations/sigma/app/sigma_detection_lab/default/savedsearches.conf
splunk/integrations/sigma/app/sigma_detection_lab/lookups/sigma_rules.csv
splunk/integrations/sigma/app/sigma_detection_lab/lookups/sigma_rule_logic.csv

# Built app packages; rebuild with sigma/bin/package-app.sh.
splunk/integrations/sigma/dist/
splunk/integrations/sigma/rules-core/
splunk/integrations/sigma/planning/

# Generated by the end-to-end validation run.
splunk/integrations/sigma/test/batches/
splunk/integrations/sigma/test/results/
