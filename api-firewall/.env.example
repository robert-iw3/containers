# Wallarm API Firewall — deployment settings.
#   cp .env.example .env    # then edit; .env is git-ignored.
# Sane defaults are baked into the image (see Dockerfile ENV) and the
# compose file; the stack runs with no .env at all. Uncomment only what you
# need to change. Container paths refer to the mounts defined in the compose
# file: ./config -> /opt/resources/config, ./crs -> /opt/resources/crs,
# ./certs -> /opt/resources/certs.

# =========================================================================
# Required for real deployments
# =========================================================================
# Your protected API, reachable from the firewall (attach the backend
# network, or point at any URL your container network can reach).
#APIFW_SERVER_URL=http://your-api:3000

# OpenAPI 3 spec describing the protected API (path relative to this dir).
#APIFW_SPEC_FILE=specs/your-api-openapi.json

# =========================================================================
# Listener / publishing
# =========================================================================
# Where the host publishes the firewall (default loopback only).
#APIFW_PUBLISHED_ADDR=0.0.0.0:8080

# PROXY (default) | API | GRAPHQL — see README for the non-proxy modes.
#APIFW_MODE=PROXY

# =========================================================================
# Validation behaviour
# =========================================================================
# BLOCK | LOG_ONLY | DISABLE
#APIFW_REQUEST_VALIDATION=BLOCK
# Default LOG_ONLY: flip to BLOCK once your spec documents every response.
#APIFW_RESPONSE_VALIDATION=LOG_ONLY
#APIFW_CUSTOM_BLOCK_STATUS_CODE=403
# Add X-Wallarm-Apifw-Validation-Status header to blocked responses.
#APIFW_ADD_VALIDATION_STATUS_HEADER=false
# Pass CORS preflight through without validation.
#APIFW_PASS_OPTIONS=false
# Per-endpoint overrides: "[METHOD:]PATH|REQUEST_MODE|RESPONSE_MODE,..."
#APIFW_ENDPOINTS=GET:/health|DISABLE|DISABLE
# Re-read the mounted spec on this interval (e.g. 1m); 0 disables.
#APIFW_SPECIFICATION_UPDATE_PERIOD=0

# Shadow-API detection (logged when request validation is LOG_ONLY).
#APIFW_SHADOW_API_EXCLUDE_LIST=404
#APIFW_SHADOW_API_UNKNOWN_PARAMETERS_DETECTION=true

# =========================================================================
# Coraza WAF + OWASP Core Rule Set  (run ./get-crs.sh first)
# =========================================================================
#APIFW_MODSEC_CONF_FILES=/opt/resources/config/coraza.conf;/opt/resources/crs/crs-setup.conf
#APIFW_MODSEC_RULES_DIR=/opt/resources/crs/rules
# Override WAF verdict handling independently of schema validation:
#APIFW_MODSEC_REQUEST_VALIDATION=BLOCK
#APIFW_MODSEC_RESPONSE_VALIDATION=LOG_ONLY

# =========================================================================
# TLS termination  (run ./tls-gen.sh, or drop your own certs in ./certs)
# =========================================================================
#APIFW_URL=https://0.0.0.0:8080
#APIFW_TLS_CERT_FILE=api-fw.crt.pem
#APIFW_TLS_CERT_KEY=api-fw.key.pem

# Upstream TLS: verify an https:// backend against a private CA…
#APIFW_SERVER_ROOT_CA=/opt/resources/certs/ca.crt.pem
# …or (dev only) skip verification.
#APIFW_SERVER_INSECURE_CONNECTION=false
# Override the Host header sent to the backend.
#APIFW_SERVER_REQUEST_HOST_HEADER=

# =========================================================================
# Token denylist / source-IP allowlist
# =========================================================================
# One token per line; see config/tokens.denylist.db for the format.
#APIFW_DENYLIST_TOKENS_FILE=/opt/resources/config/tokens.denylist.db
#APIFW_DENYLIST_TOKENS_HEADER_NAME=Authorization
#APIFW_DENYLIST_TOKENS_COOKIE_NAME=

# CIDRs/IPs allowed to call the API; requests from others are rejected.
#APIFW_ALLOW_IP_FILE=/opt/resources/config/allowed.iplist.db
# Trust a proxy header for the client IP (only behind a trusted LB!).
#APIFW_ALLOW_IP_HEADER_NAME=X-Forwarded-For

# =========================================================================
# Performance / observability
# =========================================================================
#APIFW_SERVER_MAX_CONNS_PER_HOST=512
#APIFW_SERVER_READ_TIMEOUT=5s
#APIFW_SERVER_WRITE_TIMEOUT=5s
#APIFW_SERVER_DIAL_TIMEOUT=200ms
#APIFW_MEM_LIMIT=512m
#APIFW_CPUS=1.0
#APIFW_LOG_LEVEL=INFO
#APIFW_LOG_FORMAT=JSON
# Prometheus metrics on :9010 (/metrics), enabled by default.
#APIFW_METRICS_ENABLED=true
