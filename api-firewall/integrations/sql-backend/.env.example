# apifw-sql stack settings.  cp .env.example .env  (git-ignored)

# SA password for every SQL Server shard AND the API's connection.
# Complexity rules apply: 8+ chars, upper/lower/digit/symbol.
SQL_SA_PASSWORD=ApiFw_Str0ng!Pass

# Comma-separated API keys accepted by the record-store API. The firewall
# enforces that the X-API-Key header is present; the API checks its value.
SQL_API_KEYS=demo-key-1
